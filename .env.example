# ==============================================================================
# Volleyball Tactics Platform - Environment Variables Template
# ==============================================================================

# Database Connection (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-volleyball-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Port (Render sets this dynamically, defaults to 5000)
PORT=5000

# JSON Web Token Secret (generate a strong random string)
JWT_SECRET="super-secret-volleyball-tactics-key-2026-secure"

# Google OAuth Client ID (from Google Cloud Console)
# If left empty, the platform supports seamless 1-click Demo Google Login
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

# Client URL (for CORS in production, defaults to allowing same-origin)
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
