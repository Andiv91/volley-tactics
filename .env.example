# ===================================================================
# VoleiTactics - Variables de Entorno de Ejemplo
# ===================================================================

# Puerto de escucha del servidor (Render asigna automáticamente el PORT)
PORT=5000

# Entorno de ejecución (development / production)
NODE_ENV=production

# Clave secreta para la firma de tokens JWT (Reemplazar con una cadena segura y larga)
JWT_SECRET=super-secret-jwt-token-key-voleitactics-2026

# Cadena de conexión PostgreSQL (Neon)
# Obtén esta URL en la consola de Neon (ej: Dashboard -> Connection Details -> Connection string)
# Formato: postgresql://USER:PASSWORD@ep-xyz-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# (Opcional) ID de Cliente de Google OAuth si deseas inicio de sesión con Google
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# (Opcional) URL del cliente en desarrollo
CLIENT_URL=http://localhost:5173
